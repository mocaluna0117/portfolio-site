# --- Next.js が読む変数（.env.local と Vercel に置く）---

# `npx convex dev` の初回実行で .env.local に自動で書かれる。
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# 同じデプロイの .site のアドレス（Better Auth の HTTP ルート用）。
# 本番では Vercel に手で設定する（Convex は自動で入れない）。
NEXT_PUBLIC_CONVEX_SITE_URL=

# このサイト自身のアドレス（OG 画像・sitemap の絶対 URL）。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Convex の REVALIDATE_SECRET と同じ値。Convex がデータの変更を知らせてくるときの合言葉。
REVALIDATE_SECRET=

# Cloudflare Turnstile のサイトキー。ローカルはテスト用キー（常に通る）でよい。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# 本番の Vercel だけに必要。Convex の関数とサイトを一度にデプロイするための鍵。
CONVEX_DEPLOY_KEY=

# 開発だけ: /login0117 にメールアドレスでのログイン欄を出す（本番では設定しない）。
# NEXT_PUBLIC_DEV_PASSWORD_LOGIN=true

# --- Convex が読む変数（`npx convex env set` で入れる。このファイルには置かない）---
#
#   BETTER_AUTH_SECRET        openssl rand -base64 32 で作る
#   SITE_URL                  http://localhost:3000（本番は https://mocaluna-portfolio.vercel.app）
#                             ※ Convex だけに置く。Vercel に置くと Google ログインのコールバックが壊れる
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
#   ADMIN_EMAILS              ログインを許す Google アカウントのメールアドレス
#   IMPORT_FORBIDDEN_STRINGS  取り込んだ資料に残っていたら取り込みを止める文字列（カンマ区切り。本名など）
#   REVALIDATE_SECRET         上と同じ値
#   TURNSTILE_SECRET_KEY      ローカルは 1x0000000000000000000000000000000AA（常に通る）
#   RESEND_API_KEY / CONTACT_TO_EMAIL / CONTACT_FROM_EMAIL（任意。既定は onboarding@resend.dev）
#   GITHUB_TOKEN              任意。取り込み時にコミットの sha を読む API の回数制限を緩める
#
# 開発とテストだけ（本番には設定しない）:
#   ALLOW_PASSWORD_AUTH=true  メールアドレスとパスワードでのログイン
